{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan make:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan migrate:status)",
      "Bash(php artisan db:show *)",
      "Bash(php artisan db:table *)",
      "Bash(php artisan route:list *)",
      "Bash(php artisan test *)",
      "Bash(php artisan config:clear)",
      "Bash(./vendor/bin/pint *)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(php artisan migrate:fresh *)",
      "Bash(php artisan migrate:fresh)",
      "Bash(php artisan migrate:refresh *)",
      "Bash(php artisan migrate:refresh)",
      "Bash(php artisan migrate:reset *)",
      "Bash(php artisan migrate:reset)",
      "Bash(php artisan migrate:rollback *)",
      "Bash(php artisan migrate:rollback)",
      "Bash(php artisan db:seed *)",
      "Bash(php artisan db:seed)",
      "Bash(composer require *)",
      "Bash(composer require)",
      "Bash(npm install *)",
      "Bash(npm install)",
      "Bash(git push *)",
      "Bash(git push)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./.env.testing)",
      "Edit(./.env.testing)",
      "Read(./.env.production)",
      "Bash(cat .env*)",
      "Bash(type .env*)",
      "Bash(php artisan db:wipe *)",
      "Bash(php artisan db:wipe)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)"
    ]
  }
}
